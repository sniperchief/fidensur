# Secrets — .env holds the deployer key, which owns the contract and controls setTeeAddress.
.env
.env.local
.env.*.local

# Generated by pre-build.sh
config/extension.env

# Proxy config carries Flare indexer DB credentials
config/proxy/*.toml
!config/proxy/*.toml.example

# Foundry
out/
cache/
broadcast/
# Leading slash matters: a bare `lib/` would also match frontend/lib/, silently excluding most of
# the frontend source. This anchors it to the Foundry dependency directory at the repo root.
/lib/

# Go
extension/fidensur-extension
extension/*.exe

# Node
node_modules/
.next/
frontend/out/
frontend/.vercel

# Editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Built binary — reproducible from source, no reason to track
extension/register-extension.exe
