# Fidensur deployment configuration.
#
# Copy to .env and fill in. Every script reads this file.
#   cp .env.example .env

# --- Chain -----------------------------------------------------------------

# Coston2 (Flare testnet), chain id 114. Coston (Songbird testnet) is chain id 16.
CHAIN_URL=https://coston2-api.flare.network/ext/C/rpc
CHAIN_ID=114

# The FlareTeeManager diamond. ITeeExtensionRegistry and ITeeMachineRegistry are both facets of
# this one contract, so the same address is passed twice to Fidensur's constructor.
#
# Coston2, as of 2026-07. Verify against config/coston2/deployed-addresses.json before deploying:
# if the diamond is redeployed, every registration is wiped and extension IDs change.
TEE_MANAGER_ADDRESS=0x1a9C4A0f9D76c0b1D91d22E24E573a9b377618aE

# --- Keys ------------------------------------------------------------------
#
# Deployer key, hex, no 0x prefix. Fund it from https://faucet.flare.network/coston2
#
# This key owns the Fidensur contract, which means it controls setTeeAddress — the anchor of every
# signature check the contract performs. Treat it accordingly, and never commit .env.
DEPLOYMENT_PRIVATE_KEY=

# Address derived from DEPLOYMENT_PRIVATE_KEY. Becomes the contract owner and the TEE machine owner.
INITIAL_OWNER=

# Signing key for the extension proxy. The value below is the well-known Hardhat dev key from the
# Flare scaffold — fine for testnet, never for anything else.
PROXY_PRIVATE_KEY=983760a4ebf75b2ac3a93531168a0f225d01e5dc6e3568adbd46233ba1fb4fa4

# --- TEE governance --------------------------------------------------------
#
# The signer set governing this extension's TEE machines. post-build registers these on-chain and
# the TEE node signs with them; both read these same variables, so they cannot drift. Leave unset
# for the default (deployer, threshold 1). If they disagree, TEE registration reverts with
# InvalidGovernanceHash.
# GOVERNANCE_SIGNERS="0xAbc...,0xDef..."
# GOVERNANCE_THRESHOLD=2

# --- Attestation -----------------------------------------------------------
#
# These two must agree, or registration fails with "code hashes do not match":
#
#   local development      MODE=1  SIMULATED_TEE=true   LOCAL_MODE=true
#   Coston2, simulated     MODE=1  SIMULATED_TEE=true   LOCAL_MODE=false
#   Coston2, real TEE      MODE=0  SIMULATED_TEE=false  LOCAL_MODE=false
#
# Only the third row produces attestation that Flare's data providers accept, and only the third
# row makes the verification explorer meaningful — in the others it displays a banner saying the
# attestation is simulated.
MODE=1
SIMULATED_TEE=true
LOCAL_MODE=false

# --- Proxy -----------------------------------------------------------------
#
# Public HTTPS URL of your extension proxy, tunnelled to host port 6674.
#
# Set this BEFORE running pre-build. post-build, start-services and test all read it, and changing
# it later means redeploying.
#
#   ngrok http 6674
#
# Security: this exposes the proxy HTTP API to anyone with the URL. Testnet only; stop the tunnel
# when you are finished.
EXT_PROXY_URL=https://<your-tunnel>.ngrok-free.dev

# Flare's FTDC proxy for the target chain. Pointing this at the wrong chain's proxy fails with
# Verification.TeeNotFound.
NORMAL_PROXY_URL=https://tee-proxy-coston2-1.flare.rocks

# --- Optional --------------------------------------------------------------

# LOG_LEVEL=INFO
# REGISTRY=local                        # Docker image registry
# SOURCE_DATE_EPOCH=                    # auto-derived from the last commit by start-services.sh
# REDIS_BIND=127.0.0.1:6382
# EXT_PROXY_INTERNAL_BIND=0.0.0.0:6673
# EXT_PROXY_EXTERNAL_BIND=0.0.0.0:6674
# TYPES_SERVER_BIND=127.0.0.1:8100
